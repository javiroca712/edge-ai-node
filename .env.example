# ==============================================================================
# Edge AI Node - Environment Configuration Template
# Copy this file to .env and configure for your local/remote environment.
# Note: .env is gitignored and will never be committed to the repository.
# ==============================================================================

# IP address or hostname of the bare-metal Ubuntu edge node (Tailscale IP, LAN IP, or localhost)
EDGE_NODE_HOST=100.104.80.65
EDGE_NODE_USER=ai-agent

# Grafana Dashboard Admin Password
GRAFANA_ADMIN_PASSWORD=change-me-secure-password

# Hybrid K3s Control Plane Settings
LAPTOP_TAILSCALE_IP=100.112.218.62
K3S_TOKEN=edge-ai-node-secret-token-change-me

# Container Registry & Image Tags
CONTAINER_REGISTRY=ghcr.io/javiroca712
IMAGE_TAG=latest
