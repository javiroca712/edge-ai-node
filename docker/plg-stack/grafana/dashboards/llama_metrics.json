{
  "title": "Llama.cpp Edge AI Metrics",
  "tags": ["llamacpp", "ai"],
  "timezone": "browser",
  "schemaVersion": 36,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Tokens / Sec",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(llamacpp:prompt_tokens_total[1m])",
          "legendFormat": "Prompt Tokens/s ({{instance}})"
        },
        {
          "expr": "rate(llamacpp:tokens_predicted_total[1m])",
          "legendFormat": "Predicted Tokens/s ({{instance}})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Active Decode Calls (Requests)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(llamacpp:n_decode_total[1m])",
          "legendFormat": "Decode Calls/s ({{instance}})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Max Tokens Context Size",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "targets": [
        {
          "expr": "llamacpp:n_tokens_max",
          "legendFormat": "Max Tokens ({{instance}})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Average Prompt Throughput",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "targets": [
        {
          "expr": "llamacpp:prompt_tokens_seconds",
          "legendFormat": "Avg Throughput ({{instance}})"
        }
      ]
    }
  ]
}
