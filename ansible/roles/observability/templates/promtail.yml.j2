server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /var/lib/promtail/positions.yaml

clients:
  - url: {{ loki_push_url | default('http://100.112.218.62:3100/loki/api/v1/push') }}

scrape_configs:
  - job_name: systemd-journal
    journal:
      path: /var/log/journal
      max_age: 12h
      labels:
        job: systemd-journal
        host: {{ inventory_hostname | default('ai-node') }}
    relabel_configs:
      - source_labels: ['__journal__systemd_unit']
        target_label: 'unit'
